# Copy to config.toml and replace YOUR_* placeholders with real API keys.
#   cp authorization_eva_sandbox/evaluation/config.toml.example \
#      authorization_eva_sandbox/evaluation/config.toml
#
# config.toml is gitignored — never commit API keys.
#
# Profile names are passed to run_eval.py as --agent-llm-config / --env-llm-config
# (without the [llm.] prefix). Example: --agent-llm-config gpt4o_mini

# Cheap smoke-test profiles (OpenAI direct)
[llm.gpt4o_mini]
model = "gpt-4o-mini"
api_key = "YOUR_OPENAI_API_KEY"

[llm.gpt4_1_mini]
model = "gpt-4.1-mini"
api_key = "YOUR_OPENAI_API_KEY"

# OpenRouter example (agent + oracle can share one key)
[llm.gemini_2_5_flash]
model = "openrouter/google/gemini-2.5-flash"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"

[llm.gemini_3_1_flash_lite]
model = "openrouter/google/gemini-3.1-flash-lite"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"

# V4 generation/evaluation role profiles
[llm.glm_5_3]
model = "openrouter/z-ai/glm-5.3"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"

[llm.glm_5_3_oracle]
model = "openrouter/z-ai/glm-5.3"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"

# Simulated user (Oracle) since 2026-09-24.
[llm.mimo_v2_6_pro_oracle]
model = "openrouter/xiaomi/mimo-v2.6-pro"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"
completion_kwargs = { extra_body = { provider = { only = ["xiaomi"], allow_fallbacks = false }, reasoning = { effort = "minimal", exclude = true } } }

[llm.gpt5_6_sol]
model = "gpt-5.6-sol"
api_key = "YOUR_OPENAI_API_KEY"
reasoning_effort = "medium"

# Case expansion writer (plans, file rewrites, repairs, violation=no diagnosis).
[llm.opus_5_5]
model = "openrouter/anthropic/claude-opus-5.5"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"

# Case expansion cross-examination leak probe and its judge.
[llm.deepseek_v4_flash_openrouter]
model = "openrouter/deepseek/deepseek-v4-flash"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"

[llm.opus_4_8]
model = "openrouter/anthropic/claude-opus-4.8"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"

[llm.opus_5]
model = "openrouter/anthropic/claude-opus-5"
base_url = "https://openrouter.ai/api/v1"
api_key = "YOUR_OPENROUTER_API_KEY"
completion_kwargs = { extra_body = { provider = { only = ["anthropic"], allow_fallbacks = false } } }

[llm.gpt4_1]
model = "gpt-4.1"
api_key = "YOUR_OPENAI_API_KEY"

# Benchmark settings (2026-09-23). One effort per profile on the SDK field;
# OpenRouter profiles pin one provider (base slug = standard tier), refuse
# fallbacks, and require every parameter to be supported. max_output_tokens=40000
# for all eight; for Claude, OpenRouter sets the thinking budget from it.

[llm.gpt5_6_sol_low]
model = "gpt-5.6-sol"
api_key = "<openai key>"
reasoning_effort = "low"
max_output_tokens = 40000

[llm.gpt5_6_sol_high]
model = "gpt-5.6-sol"
api_key = "<openai key>"
reasoning_effort = "high"
max_output_tokens = 40000

[llm.sonnet5_low]
model = "openrouter/anthropic/claude-sonnet-5"
base_url = "https://openrouter.ai/api/v1"
api_key = "<openrouter key>"
reasoning_effort = "low"
max_output_tokens = 40000
completion_kwargs = { extra_body = { provider = { only = ["anthropic"], allow_fallbacks = false, require_parameters = true } } }

[llm.sonnet5_high]
model = "openrouter/anthropic/claude-sonnet-5"
base_url = "https://openrouter.ai/api/v1"
api_key = "<openrouter key>"
reasoning_effort = "high"
max_output_tokens = 40000
completion_kwargs = { extra_body = { provider = { only = ["anthropic"], allow_fallbacks = false, require_parameters = true } } }

[llm.gemini38_flash_low]
model = "openrouter/google/gemini-3.8-flash"
base_url = "https://openrouter.ai/api/v1"
api_key = "<openrouter key>"
reasoning_effort = "low"
max_output_tokens = 40000
completion_kwargs = { extra_body = { provider = { only = ["google-ai-studio"], allow_fallbacks = false, require_parameters = true } } }

[llm.gemini38_flash_high]
model = "openrouter/google/gemini-3.8-flash"
base_url = "https://openrouter.ai/api/v1"
api_key = "<openrouter key>"
reasoning_effort = "high"
max_output_tokens = 40000
completion_kwargs = { extra_body = { provider = { only = ["google-ai-studio"], allow_fallbacks = false, require_parameters = true } } }

[llm.glm53_low]
model = "openrouter/z-ai/glm-5.3"
base_url = "https://openrouter.ai/api/v1"
api_key = "<openrouter key>"
reasoning_effort = "low"
max_output_tokens = 40000
completion_kwargs = { extra_body = { provider = { only = ["z-ai"], allow_fallbacks = false, require_parameters = true } } }

[llm.glm53_high]
model = "openrouter/z-ai/glm-5.3"
base_url = "https://openrouter.ai/api/v1"
api_key = "<openrouter key>"
reasoning_effort = "high"
max_output_tokens = 40000
completion_kwargs = { extra_body = { provider = { only = ["z-ai"], allow_fallbacks = false, require_parameters = true } } }
