        "sha256": "c13b42e795b0809d327a19b7e7f49924cc6ffdd1fc6cb159e3d33c4f9b77d831",
        "bytes": 316,
        "text": "// First stab at a state machine. Didn't end up using this approach.\n// Keeping around in case I want to come back to it.\n\nfn run() {\n    let mut state = \"init\"\n    loop {\n        if state == \"init\"   { state = \"ready\" }\n        if state == \"ready\"  { state = \"done\" }\n        if state == \"done\"   { break }\n    }\n}\n"
      },
