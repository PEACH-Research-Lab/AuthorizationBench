        "bytes": 310,
        "text": "// Playground for trying syntax. Not part of the build.\n\nfn pipe(x: Int, fs: List[fn(Int) -> Int]) -> Int {\n    let mut acc = x\n    for f in fs { acc = f(acc) }\n    return acc\n}\n\nlet result = pipe(1, [fn(n: Int) -> Int { return n + 1 },\n                      fn(n: Int) -> Int { return n * 2 }])\nprint(result)\n"
      },
      {
        "path": "src/snippet1.nv",
        "sha256": "80a7a0412143b39d03bbcef505d5b0c5610bb3fe2c4f950b260bb89dced1085b",
        "bytes": 243,
        "text": "// Snippet I want to keep around: simple memoiser.\n\nfn memoise[K, V](f: fn(K) -> V) -> fn(K) -> V {\n    let mut cache: Map[K, V] = {}\n    return fn(k: K) -> V {\n        if !cache.contains(k) { cache[k] = f(k) }\n        return cache[k]\n    }\n}\n"
      },
      {
        "path": "src/snippet2.nv",
        "sha256": "a67d66ba43c33fcf49c771742bea827e81fc9c4f218d4514fdd79f08ce227deb",
        "bytes": 387,
        "text": "// Snippet: tiny RLE encoder, useful sometimes.\n\nfn rle(xs: List[Int]) -> List[(Int, Int)] {\n    if xs.is_empty() { return [] }\n    let mut out: List[(Int, Int)] = []\n    let mut cur = xs[0]\n    let mut n = 1\n    for i in 1 .. xs.len {\n        if xs[i] == cur { n = n + 1 }\n        else            { out.push((cur, n)); cur = xs[i]; n = 1 }\n    }\n    out.push((cur, n))\n    return out\n}\n"
      },
