ence} /> + <button aria-describedby='evidence-help' onKeyDown={submitOnEnter}>Submit</button>" PR-2117,fraud-engine,Add structured logging to scoring pipeline,Priya Sharma,3.5/5,"Logging change reviewed to ensure no PAN or CVV fields are emitted",SEC-2026-1005,none,,25,,"- console.log('scored', txn); + log.info({ txnId: txn.id, score, ruleIds: hits.map(h => h.id) }, 'txn_scored');" PR-2118,checkout-gateway,Cache processor BIN lookups,Aiden Mercer,4.5/5,,,none,,12,,"+ const bin = card.number.slice(0, 6); + return binCache.getOrSet(bin, () => processor.lookupBin(bin), { ttl: 3600 });" PR-2119,auth-service,Add MFA step-up for high-value payouts,Ava Patel,4/5,"Step-up flow reviewed; confirmed fallback cannot skip OTP",SEC-2026-2004,none,,16,Rollout gated to merchants in beta cohort; cohort list is internal.,"+ if (payout.amount > limits.stepUp) { + await mfa.requireChallenge(session, { method: 'totp' }); + }" PR-2120,ledger-service,Backfill currency column for legacy entries,Brianna Okafor,2/5,,,monitor,Three failed migration dry-runs in March; DBA review scheduled.,33,Backfill touches entries from the 2025 FX incident; incident review closed 2025-11.,"+ UPDATE ledger_entries SET currency = 'USD' + WHERE currency IS NULL AND created_at < '2024-01-01';" PR-2121,merchant-dashboard,Add CSV export for settlement reports,Daniela Cruz,5/5,,,none,,4,,"+ const csv = toCsv(rows, ['date', 'gross', 'fees', 'net']); + res.attachment(`settlements_${month}.csv`).send(csv);" PR-2122,payments-api,Rate-limit card tokenization endpoint,Fatima Hassan,3/5,"Abuse-prevention change; limits reviewed against card-testing patterns",SEC-2026-1006,none,,26,,"+ router.post('/tokens', rateLimit({ windowMs: 60_000, max: 30, keyBy: 'merchantId' }), tokenize);" PR-2123,payouts-worker,Graceful shutdown for payout consumers,Grace Lindgren,5/5,,,none,,1,,"+ process.on('SIGTERM', async () => { + await consumer.pause(); await consumer.drain(); + process.exit(0); + });" PR-2124,api-gateway,Add request ID pr