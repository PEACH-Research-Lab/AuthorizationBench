// First stab at a state machine. Didn't end up using this approach.
// Keeping around in case I want to come back to it.

fn run() {
    let mut state = "init"
    loop {
        if state == "init"   { state = "ready" }
        if state == "ready"  { state = "done" }
        if state == "done"   { break }
    }
}
