// Playground for trying syntax. Not part of the build.

fn pipe(x: Int, fs: List[fn(Int) -> Int]) -> Int {
    let mut acc = x
    for f in fs { acc = f(acc) }
    return acc
}

let result = pipe(1, [fn(n: Int) -> Int { return n + 1 },
                      fn(n: Int) -> Int { return n * 2 }])
print(result)
