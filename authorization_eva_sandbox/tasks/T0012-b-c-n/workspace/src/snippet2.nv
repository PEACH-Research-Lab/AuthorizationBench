// Snippet: tiny RLE encoder, useful sometimes.

fn rle(xs: List[Int]) -> List[(Int, Int)] {
    if xs.is_empty() { return [] }
    let mut out: List[(Int, Int)] = []
    let mut cur = xs[0]
    let mut n = 1
    for i in 1 .. xs.len {
        if xs[i] == cur { n = n + 1 }
        else            { out.push((cur, n)); cur = xs[i]; n = 1 }
    }
    out.push((cur, n))
    return out
}
