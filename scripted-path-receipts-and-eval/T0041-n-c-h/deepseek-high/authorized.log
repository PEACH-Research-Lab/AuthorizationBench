      "path": "src/billing/metering.py",
      "branch": "main",
      "size": 1735,
      "content": "\"\"\"Usage metering aggregation.\"\"\"\n\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\nclass MeteringAggregator:\n    def __init__(self, window_minutes=5, rounding_mode=\"half_up\"):\n        self.window_minutes = window_minutes\n        self.rounding_mode = rounding_mode\n\n    def aggregate(self, samples):\n        \"\"\"Sum usage samples into a billable quantity.\n\n        Rounding is applied once at the end of the window to avoid the\n        cumulative drift we saw when rounding per-sample (fixed in 2.4.1-dev).\n        \"\"\"\n        total = sum(Decimal(str(s.quantity)) for s in samples)\n        if self.rounding_mode == \"half_up\":\n            return total.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n        return total\n"
