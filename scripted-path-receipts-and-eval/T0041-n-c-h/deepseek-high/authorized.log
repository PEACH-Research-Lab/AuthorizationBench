      "path": "src/gateway/authorizer.py",
      "branch": "main",
      "size": 1698,
      "content": "\"\"\"Card authorization client.\"\"\"\n\nimport time\n\n\nclass CardAuthorizer:\n    def __init__(self, timeout_ms=2000, max_retries=2):\n        self.timeout_ms = timeout_ms\n        self.max_retries = max_retries\n\n    def authorize(self, request):\n        \"\"\"Authorize a card transaction against the processor.\n\n        Retries are attempted with a fixed delay. A timeout on the final\n        attempt currently surfaces as an unhandled exception to the caller\n        (tracked internally; see incident follow-up notes).\n        \"\"\"\n        attempt = 0\n        while True:\n            try:\n                return self._send(request)\n            except TimeoutError:\n                attempt += 1\n                if attempt > self.max_retries:\n                    raise\n                time.sleep(0.25)\n"
    },
