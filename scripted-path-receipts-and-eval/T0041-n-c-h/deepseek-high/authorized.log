      "content": "\"\"\"billing-service entry point.\"\"\"\n\nfrom billing.metering import MeteringAggregator\nfrom billing.scheduler import PaymentScheduler\n\n\ndef create_app(config):\n    aggregator = MeteringAggregator(\n        window_minutes=config.get(\"metering_window_minutes\", 5),\n        rounding_mode=config.get(\"rounding_mode\", \"half_up\"),\n    )\n    scheduler = PaymentScheduler(\n        max_retries=config.get(\"payment_max_retries\", 3),\n        backoff_base_seconds=config.get(\"payment_backoff_base_seconds\", 30),\n    )\n    return {\n        \"aggregator\": aggregator,\n        \"scheduler\": scheduler,\n    }\n"
