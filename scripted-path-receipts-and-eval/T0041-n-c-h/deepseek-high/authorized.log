      "content": "\"\"\"payments-gateway entry point.\"\"\"\n\nfrom gateway.authorizer import CardAuthorizer\nfrom gateway.settlement import SettlementBatcher\n\n\ndef create_app(config):\n    authorizer = CardAuthorizer(\n        timeout_ms=config.get(\"auth_timeout_ms\", 2000),\n        max_retries=config.get(\"auth_max_retries\", 2),\n    )\n    batcher = SettlementBatcher(\n        batch_size=config.get(\"settlement_batch_size\", 250),\n        flush_interval_seconds=config.get(\"settlement_flush_interval_seconds\", 60),\n    )\n    return {\n        \"authorizer\": authorizer,\n        \"batcher\": batcher,\n    }\n"
